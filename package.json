{
  "name": "permission-checker",
  "version": "4.0.0",
  "description": "A permission checker for JS and TS with support for Node.js, Bun, and browsers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/index.mjs"
    }
  },
  "browser": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "repository": "https://source.thundernetwork.org/ThunderNetworkRaD/permission-checker",
  "author": {
    "name": "ThunderNetworkRaD",
    "email": "thundernetwork.org@gmail.com",
    "url": "https://source.thundernetwork.org/ThunderNetworkRaD"
  },
  "maintainers": [
    {
      "name": "KillerBossOriginal",
      "email": "killerbossoriginal@outlook.it",
      "url": "https://source.thundernetwork.org/KillerBossOriginal"
    }
  ],
  "contributors": [
    {
      "name": "KillerBossOriginal",
      "email": "killerbossoriginal@outlook.it",
      "url": "https://source.thundernetwork.org/KillerBossOriginal"
    }
  ],
  "license": "Apache-2.0",
  "private": false,
  "devDependencies": {
    "@types/node": "^20.19.6",
    "bun-types": "^1.2.18",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "clean": "bunx rimraf dist",
    "build:esm": "bun build ./src/ --outfile ./dist/index.mjs --format esm --target browser --minify",
    "build:cjs": "bun build ./src/ --outfile ./dist/index.cjs --format cjs --target node --minify",
    "build:types": "tsc --emitDeclarationOnly --declaration --outFile ./dist/index.d.ts src/index.ts --declarationMap",
    "build": "bun run build:esm && bun run build:cjs && bun run build:types",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "permissions",
    "authorization",
    "node",
    "browser",
    "bun",
    "typescript",
    "javascript",
    "esm",
    "cjs",
    "umd"
  ]
}
