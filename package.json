{
  "name": "permission-checker",
  "version": "4.1.3",
  "description": "A permission checker for JS and TS with support for Node.js, Bun, and browsers.",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "browser": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/esm/index.mjs"
    }
  },
  "files": [
    "dist",
    "launchers"
  ],
  "repository": "https://source.thundernetwork.org/ThunderNetworkRaD/permission-checker",
  "author": {
    "name": "ThunderNetworkRaD",
    "email": "thundernetwork.org@gmail.com",
    "url": "https://source.thundernetwork.org/ThunderNetworkRaD"
  },
  "maintainers": [
    {
      "name": "KillerBossOriginal",
      "email": "killerbossoriginal@outlook.it",
      "url": "https://source.thundernetwork.org/KillerBossOriginal"
    }
  ],
  "contributors": [
    {
      "name": "KillerBossOriginal",
      "email": "killerbossoriginal@outlook.it",
      "url": "https://source.thundernetwork.org/KillerBossOriginal"
    }
  ],
  "license": "Apache-2.0",
  "private": false,
  "devDependencies": {
    "@types/node": "^20.19.6",
    "bun-types": "^1.2.18",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "clean": "bunx rimraf dist",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "bun run clean && mkdir -p dist && bun run build:esm && bun run build:cjs && bun run build:types",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "permissions",
    "authorization",
    "node",
    "browser",
    "bun",
    "typescript",
    "javascript",
    "esm",
    "cjs",
    "umd"
  ]
}
